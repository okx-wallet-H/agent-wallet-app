# ============================================
# Agent Wallet — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real secrets.

# ─── Server ────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─── JWT ───────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ISSUER=agent-wallet
JWT_AUDIENCE=agent-wallet-users
JWT_REALM=Agent Wallet

# ─── Database ──────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/agentwallet
DB_USER=agentwallet
DB_PASSWORD=agentwallet

# ─── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── OKX Onchain OS ────────────────────────
# Get from: https://web3.okx.com/onchainos/dev-portal
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
OKX_BASE_URL=https://web3.okx.com

# ─── Coinbase CDP ──────────────────────────
# Get from: https://portal.cdp.coinbase.com
COINBASE_API_KEY=your-cdp-api-key
COINBASE_SECRET_KEY=your-cdp-secret-key

# ─── Anthropic Claude ──────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-5
